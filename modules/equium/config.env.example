# =============================================================================
# Equium ($EQM) Mining Configuration
# =============================================================================
# Copy this file to config.env and fill in your values.
# All values shown are defaults (except API keys).

# -----------------------------------------------------------------------------
# RPC Endpoints
# -----------------------------------------------------------------------------
# Primary RPC (use a private endpoint for best performance)
EQUIUM_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Fallback RPCs (numbered 1-9, tried in order when primary fails)
EQUIUM_RPC_FALLBACK_1=https://api.mainnet-beta.solana.com
EQUIUM_RPC_FALLBACK_2=https://rpc.shyft.to?api_key=YOUR_SHYFT_KEY
EQUIUM_RPC_FALLBACK_3=https://solana-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# -----------------------------------------------------------------------------
# Wallet
# -----------------------------------------------------------------------------
EQUIUM_KEYPAIR_PATH=~/.config/solana/id.json

# -----------------------------------------------------------------------------
# Worker Settings
# -----------------------------------------------------------------------------
# Number of parallel miner instances (default: number of CPU cores)
EQUIUM_NUM_WORKERS=4

# Max nonce attempts per round per worker before re-fetching state
# Higher = more attempts before checking for new round
# Lower = more responsive to difficulty/challenge changes
EQUIUM_MAX_NONCES=65536

# Compute unit limit per mine transaction
EQUIUM_CU_LIMIT=1400000

# Priority fee in micro-lamports per CU (0 = no priority fee)
# Helps during congestion. 1000 = ~1.4 SOL per 1M CU tx = 0.0014 SOL
EQUIUM_PRIORITY_FEE_LAMPORTS=0

# -----------------------------------------------------------------------------
# Build Settings
# -----------------------------------------------------------------------------
# Path to equium source repository
EQUIUM_SOURCE_DIR=/projects/sandbox/equium

# Path to compiled binary (auto-detected after build)
EQUIUM_BINARY_PATH=/projects/sandbox/equium/target/release/equium-miner

# Auto-build binary if not found
EQUIUM_AUTO_BUILD=true

# Build with native CPU optimizations (RUSTFLAGS="-C target-cpu=native")
EQUIUM_NATIVE_CPU=true

# -----------------------------------------------------------------------------
# Process Management
# -----------------------------------------------------------------------------
# Auto-restart crashed workers
EQUIUM_AUTO_RESTART=true

# Initial restart delay (seconds)
EQUIUM_RESTART_DELAY_SECS=3

# Maximum restart delay after repeated failures (seconds)
EQUIUM_MAX_RESTART_DELAY_SECS=60

# Backoff multiplier (delay doubles each consecutive failure)
EQUIUM_BACKOFF_MULTIPLIER=2.0

# Kill and restart worker if no output for this many seconds
EQUIUM_HEALTH_TIMEOUT_SECS=300

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
EQUIUM_LOG_DIR=./logs/equium
EQUIUM_LOG_LEVEL=INFO
EQUIUM_MAX_LOG_SIZE_MB=50
EQUIUM_MAX_LOG_FILES=10

# -----------------------------------------------------------------------------
# Advanced / Program IDs (usually no need to change)
# -----------------------------------------------------------------------------
EQUIUM_PROGRAM_ID=ZKGMUfxiRCXFPnqz9zgqAnuqJy15jk7fKbR4o6FuEQM
EQUIUM_MINT=1MhvZzEe8gQ8Rb9CrT3Dn26Gkn9QRErzLMGkkTwveqm
EQUIUM_POLL_INTERVAL_SECS=2.0
