# DAC Inception Automation Environment Template
# Copy: cp .env.example .env
# IMPORTANT: Never commit your real .env

# MetaMask credentials
METAMASK_SEED="your 12 word seed phrase"
METAMASK_PASSWORD="your_metamask_password"

# DAC web session (generated by node dac-auth.js / dac-refresh.js)
DAC_SESSIONID="your_sessionid"
DAC_CSRFTOKEN="your_csrftoken"
DAC_REF_CODE="DAC00014"

# EVM private key (TESTNET ONLY)
WALLET_PRIVATE_KEY="0x_your_testnet_private_key"

# Network
CHAIN_ID=21894
RPC_URL="https://rpctest.dachain.tech"
DAC_API_BASE="https://inception.dachain.io/api/inception"

# Paths
METAMASK_EXTENSION_PATH="/home/ubuntu/metamask-agent/metamask"

# Runtime
HEADLESS=false
